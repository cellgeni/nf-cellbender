{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cellgeni/nf-cellbender/main/assets/schema_samples.json",
  "title": "cellgeni/nf-cellbender samples table",
  "description": "Schema for the file provided with --samples",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^\\S+$",
        "meta": [
          "id"
        ],
        "errorMessage": "Sample id must be provided and cannot contain spaces"
      },
      "path": {
        "type": "string",
        "pattern": "^\\S+$",
        "errorMessage": "Path must be provided and cannot contain spaces"
      }
    },
    "required": [
      "id",
      "path"
    ]
  },
  "uniqueEntries": [
    "id"
  ]
}
