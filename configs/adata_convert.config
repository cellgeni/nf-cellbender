process {
  // cellbender_filtered.h5 -> cellbender_filtered.h5ad, published next to the CellBender files.
  // Features are named by gene id, with the symbols in var["gene_symbols"]; ext.args can change that
  // (e.g. "--var-names gene_symbols --make-unique")
  withName: '.*ADATA_CONVERT' {
    ext.prefix = 'cellbender_filtered'
    cpus       = 1
    memory     = { 4.GB * task.attempt }
    queue      = 'normal'
  }
}
