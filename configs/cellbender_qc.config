process {
  withName: '.*CELLBENDER_QC' {
    ext.qc_mode = params.qc_mode
    cpus        = 2
    memory      = { 8.GB * task.attempt }
    queue       = 'normal'
    publishDir  = [
      path: { "${params.output_dir}/" },
      mode: "${params.publish_mode}",
      pattern: "qc_report",
    ]
  }
}
