process {
  // Shared by the CellBender 0.2 and 0.3 modules
  withName: '.*CELLBENDER_REMOVEBACKGROUND_V0[23]' {
    ext.starsolo_mapper = params.starsolo_mapper
    ext.expected_cells  = params.cells
    ext.total_droplets  = params.droplets
    ext.umi_threshold   = params.min_umi
    // GPU memory grows with each retry, so a sample that ran out of memory moves off the 16 GB cards.
    // TEMPORARY: GPU 3 of farm-gpu0203 fails every CellBender job with CUDA errors (2026-10-21).
    // Remove the hname selection once IDS has fixed or drained that GPU. LSF needs the quotes
    // around the host name, otherwise it reads the "-" as a minus.
    clusterOptions      = {
      " -gpu \"mode=shared:j_exclusive=no:gmem=${8000 * task.attempt}:num=1\" -R \"select[hname!='farm-gpu0203']\"" + (params.costcode ? " -G ${params.costcode.toString().trim().toLowerCase()}" : '')
    }
    containerOptions    = '--nv'
    cpus                = 2
    memory              = { 30.GB * task.attempt }
    queue               = params.gpuqueue
    errorStrategy       = { task.attempt > task.maxRetries && params.ignore_failed ? 'ignore' : 'retry' }
  }

  // CellBender 0.2: the mapper preset is used unless both --cells and --droplets are given
  withName: '.*CELLBENDER_REMOVEBACKGROUND_V02' {
    ext.mapper_preset = !(params.cells && params.droplets)
    ext.args          = {
      [
        params.exclude_features == "All" ? "--exclude-antibody-capture"  : '',
        params.epochs                    ? "--epochs ${params.epochs}"    : '',
        params.fpr                       ? "--fpr ${params.fpr}"          : '',
        params.lr                        ? "--learning-rate ${params.lr}" : '',
      ].join(' ')
    }
  }

  withName: '.*CELLBENDER_REMOVEBACKGROUND_V03' {
    ext.mapper_preset = params.mapper_preset
    ext.args          = {
      [
        params.exclude_features      ? "--exclude-feature-type " + params.exclude_features.split(',').collect { feature -> "\"${feature.trim()}\"" }.join(' ') : '',
        params.estimator             ? "--estimator ${params.estimator}"                                                                                       : '',
        params.force_empty_umi_prior ? "--force-empty-umi-prior ${params.force_empty_umi_prior}"                                                               : '',
        params.epochs                ? "--epochs ${params.epochs}"                                                                                             : '',
        params.fpr                   ? "--fpr ${params.fpr}"                                                                                                   : '',
        params.lr                    ? "--learning-rate ${params.lr}"                                                                                          : '',
      ].join(' ')
    }
  }
}
