process {
  withName: '.*IRODS_LOADCATALOG' {
    ext.ignore_extensions = params.ignore_extensions
    ext.args              = '-f -v -K -X restartfile.txt --retries 5'
    cpus                  = 1
    memory                = { 2.GB * task.attempt }
    array                 = 20
    queue                 = 'transfer'
    maxForks              = 5
    publishDir            = [
      path: { "${params.output_dir}/raw/" },
      mode: "${params.publish_mode}",
    ]
  }
}
