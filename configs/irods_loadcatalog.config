process {
  withName: '.*IRODS_LOADCATALOG' {
    ext.ignore_extensions = params.ignore_extensions ?: "bam,cram,fastq,fq,fastq.gz,fq.gz,fastq.bz2,fq.bz2,fastq.xz,fq.xz,fastq.lz4,fq.lz4,mate1.bz2,mate2.bz2"
    ext.args              = '-f -v -K -X restartfile.txt --retries 5'
    cpus                  = 1
    memory                = { 2.GB * task.attempt }
    array                 = 20
    queue                 = 'transfer'
    maxForks              = 5
  }
}
