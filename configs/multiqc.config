process {
  withName: '.*MULTIQC' {
    cpus       = 1
    memory     = { 4.GB * task.attempt }
    queue      = 'normal'
    publishDir = [
      path: { "${params.output_dir}/qc_report/" },
      mode: "${params.publish_mode}",
      saveAs: { filename -> filename == 'versions.yml' ? null : filename },
    ]
  }
}
