#BSUB -G cellgeni
#BSUB -q oversubscribed
#BSUB -n 1
#BSUB -M 4G
#BSUB -R "select[mem>4G] rusage[mem=4G]"
#BSUB -J nf-cellbender
#BSUB -o nf-cellbender.%J.log
#BSUB -e nf-cellbender.%J.err

# examples/run_cellbender.sh as an LSF job, so the run does not depend on your login session.
# Submit it from the repository root:
#
#   bsub < examples/run_cellbender.bsub
#
# This is the Nextflow head job: it only submits and watches the iRODS, CellBender, QC and MultiQC
# jobs, so it needs little memory, but it has to stay alive until every sample has finished, hence
# the oversubscribed queue. The downloads use your own iRODS login, which compute nodes share.

set -euo pipefail

module load cellgen/nextflow/26.04.6

# Keep Nextflow's Java heap inside the job's 4 GB memory limit
export NXF_OPTS="-Xms1g -Xmx3g"

samples=examples/samples_groups.csv

[[ -e "$samples" ]] || (echo "File $samples not found" && false)

nextflow run main.nf \
  --samples $samples \
  --on_irods \
  --exclude_features "Peaks,Multiplexing Capture,CRISPR Guide Capture" \
  --ignore_extensions "bam,bz2" \
  -ansi-log false \
  --outdir "my-cellbender-v3-results"
