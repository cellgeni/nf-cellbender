nextflow_process {

    name "Test Process CELLBENDER_QC"
    script "../main.nf"
    process "CELLBENDER_QC"

    tag "modules"
    tag "cellbender/qc"

    // The QC reads CellBender output, which is not byte-identical between runs, so the real test checks
    // the outputs' structure and contents rather than a snapshot. Its setup runs CellBender 0.3 on a GPU
    test("CellRanger count v3.0.0 - CellBender v0.3 output") {
        tag "cellranger-count"
        tag "gex"
        tag "v0.3"

        setup {
            run("CELLBENDER_REMOVEBACKGROUND_V03") {
                script "../../removebackground_v03/main.nf"
                process {
                    """
                    input[0] = [
                        [id:'cellranger-count'], // meta map
                        file(params.test_data_base + 'cellranger-count', checkIfExists: true),
                        null, null, null, [], // cells, droplets and threshold from CellBender; no excluded features
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = CELLBENDER_REMOVEBACKGROUND_V03.out.outputdir
                    .map { _meta, dir -> [[id:'test'], dir] }
                    .groupTuple()
                """
            }
        }

        then {
            assert process.success
            def report  = process.out.report[0][1]
            def summary = path("${report}/cellbender_qc_summary.tsv").readLines()
            assertAll(
                { assert process.out.report[0][0] == [id:'test'] },
                { assert process.out.multiqc_files[0][0] == [id:'test'] },
                { assert summary.size() == 2 },
                { assert summary[0].startsWith('sample_id\t') },
                { assert summary[1].startsWith('cellranger-count\t') },
                { assert new File("${report}/cellbender_qc_report.pdf").length() > 0 },
                { assert new File("${report}/multiqc/cellbender_summary_mqc.json").length() > 0 },
                { assert process.out.findAll { key, _value -> key.startsWith('versions') }.collect { _key, value -> value[0][1] } as Set == ['python', 'h5py', 'matplotlib', 'numpy', 'pandas'] as Set }
            )
        }
    }

    test("Stub") {
        tag "cellbender-qc-stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id:'test'], // meta map: the group of samples
                    [
                        file(params.test_data_base + 'cellranger-count', checkIfExists: true),
                        file(params.test_data_base + 'starsolo', checkIfExists: true),
                    ],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
