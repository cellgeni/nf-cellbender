nextflow_process {

    name "Test Process CELLBENDER_REMOVEBACKGROUND_V02"
    script "../main.nf"
    process "CELLBENDER_REMOVEBACKGROUND_V02"

    tag "modules"
    tag "cellbender/removebackground_v02"
    test("CellRanger count v3.0.0 - CellBender v0.2") {
        tag "cellranger-count"
        tag "gex"
        tag "mapper-output"
        tag "mapper-preset"
        tag "v0.2"

        when {
            process {
                """
                input[0] = [
                    [id:'cellranger-count'], // meta map
                    file(params.test_data_base + 'cellranger-count', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert process.out.outputdir },
                { assert snapshot(process.out).match() }
            )
        }

    }
    test("STARsolo - CellBender v0.2") {
        tag "starsolo"
        tag "gex"
