    test("CellRanger count v3.0.0 - .h5 file input - CellBender v0.2") {
        tag "cellranger-count"
        tag "gex"
        tag "h5"
        tag "manual-preset"
        tag "v0.2"

        when {
            params {
                cells         = 1200
                droplets      = 3200
                min_umi       = 10
            }
            process {
                """
                input[0] = [
                    [id:'cellranger-count'], // meta map
