    test("CellRanger multi v6.0.0 - one cellplex sample is rejected - CellBender v0.3") {
        tag "cellranger-multi"
        tag "cellplex-sample"
        tag "input-error"
        tag "v0.3"

        when {
            process {
                """
                input[0] = [
                    [id:'human1'], // meta map
                    file(params.test_data_base + 'sample-multiplexing/outs/multi/per_sample_outs/human1', checkIfExists: true),
                    null, null, null, // expected cells, total droplets, low-count threshold
                    [], // feature types to exclude
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("only its called cells and no raw matrix") }
            )
        }

    }

    test("CellRanger count v3.0.0 - preset off without droplets is rejected - CellBender v0.3") {
        tag "cellranger-count"
        tag "h5"
        tag "preset-off"
        tag "input-error"
        tag "v0.3"

        when {
            params {
                preset          = "off"
            }
            process {
                """
                input[0] = [
                    [id:'cellranger-count'], // meta map
                    file(params.test_data_base + 'cellranger-count/outs/raw_feature_bc_matrix.h5', checkIfExists: true),
                    1200, null, null, // expected cells, total droplets, low-count threshold
                    [], // feature types to exclude
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("--preset off uses only the values given, and total droplets is not given") }
            )
        }

    }
}
