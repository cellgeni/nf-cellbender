nextflow_process {

    name "Test Process CELLBENDER_REMOVEBACKGROUND_V03"
    script "../main.nf"
    process "CELLBENDER_REMOVEBACKGROUND_V03"

    tag "modules"
    tag "cellbender/removebackground_v03"

    // CellBender output is not byte-identical between runs (the log has the date, training is
    // stochastic), so the tests check that it ran to completion and wrote every output file
    def outputs = [
        'cellbender.h5',
        'cellbender.log',
        'cellbender.pdf',
        'cellbender_cell_barcodes.csv',
        'cellbender_filtered.h5',
        'cellbender_metrics.csv',
        'cellbender_posterior.h5',
        'cellbender_report.html',
    ]
    // Outputs emitted by extension, each a tuple with the sample's meta
    def emitted = ['outputdir', 'h5', 'csv', 'pdf', 'html', 'log']

    test("CellRanger count v3.0.0 - CellBender v0.3") {
        tag "cellranger-count"
        tag "gex"
        tag "mapper-output"
        tag "v0.3"

        when {
            process {
                """
                input[0] = [
                    [id:'cellranger-count'], // meta map
                    file(params.test_data_base + 'cellranger-count', checkIfExists: true),
                    null, null, null, // expected cells, total droplets, low-count threshold
                    [], // feature types to exclude
                ]
                """
            }
        }

        then {
            assert process.success
            def outdir   = new File(process.out.outputdir[0][1])
            def log      = new File(outdir, 'cellbender.log').text
            // What prepare_cellbender.py printed: the input structure, the features and the numbers used
            def prepared = new File(outdir.parentFile, '.command.out').text
            assertAll(
                { assert process.out.versions_cellbender == [['CELLBENDER_REMOVEBACKGROUND_V03', 'cellbender', '0.3.2']] },
                { assert outdir.list().sort() == outputs },
                { assert outputs.findAll { name -> new File(outdir, name).length() == 0 } == [] },
                { assert emitted.every { emit -> process.out[emit][0][0] == [id:'cellranger-count'] } },
                { assert prepared.contains("holds Cell Ranger count output") },
                { assert prepared.contains("none ignored") },
                { assert log.contains('Completed remove-background.') }
            )
        }

    }

