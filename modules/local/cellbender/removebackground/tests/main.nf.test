// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test cellbender/removebackground
nextflow_process {

    name "Test Process CELLBENDER_REMOVEBACKGROUND"
    script "../main.nf"
    process "CELLBENDER_REMOVEBACKGROUND"

    tag "modules"
    tag "cellbender/removebackground"

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("CellRanger count v3.0.0 - CellBender v0.3") {
        tag "cellranger-count"
        tag "gex"
        tag "mapper-output"
        tag "v0.3"

        when {
            params {
                version = "0.3"
            }
            process {
                """
                input[0] = [
                    [id:'cellranger-count'], // meta map
                    file(params.test_data_base + 'cellranger-count', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert process.out.outputdir },
                { assert snapshot(process.out).match() }
            )
        }

    }

